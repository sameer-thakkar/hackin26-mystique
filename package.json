{
  "name": "mystique",
  "version": "1.0.0",
  "description": "Microbrands at Headout",
  "scripts": {
    "dev": "next -p 3001",
    "build": "next build",
    "start": "next start",
    "production": "node ./deployment/production && find now.*.json | xargs -n1 -I {} /bin/bash -c 'now -A {} --scope headout --prod --no-clipboard --debug' && rm -r now.*.json",
    "staging": "node ./deployment/stage && find now.*.json | xargs -n1 -I {} /bin/bash -c 'now -A {} --scope headout --prod --no-clipboard --debug' && rm -r now.*.json"
  },
  "author": "Aakash Goel",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "5.6.2",
    "@zeit/next-css": "^1.0.1",
    "axios": "^0.19.0",
    "classnames": "^2.2.6",
    "cookies": "^0.7.3",
    "isomorphic-unfetch": "^3.0.0",
    "lazysizes": "^5.1.1",
    "libphonenumber-js": "^1.7.22",
    "moment": "^2.24.0",
    "next": "^9.0.4",
    "prismic-javascript": "^2.1.1",
    "prismic-reactjs": "^1.0.1",
    "react": "^16.9.0",
    "react-alice-carousel": "^1.15.2",
    "react-copy-to-clipboard": "^5.0.1",
    "react-datepicker": "^2.8.0",
    "react-dom": "^16.9.0",
    "react-html-parser": "^2.0.2",
    "react-id-swiper": "^2.3.2",
    "react-json-tree": "^0.11.2",
    "react-markdown": "^4.2.1",
    "react-modal": "^3.9.1",
    "react-scroll": "^1.7.14",
    "react-select": "^3.0.4",
    "react-telephone-input": "^4.73.4",
    "signale": "^1.4.0",
    "swiper": "^4.5.0",
    "url-parse": "^1.4.7",
    "xmlbuilder": "^13.0.2"
  },
  "devDependencies": {
    "@types/node": "^12.7.1",
    "@types/react": "^16.9.0",
    "husky": "^3.0.3",
    "prettier": "^1.18.2",
    "pretty-quick": "^1.11.1",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^3.5.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "main": "index.js",
  "repository": "https://github.com/headout/mystique.git"
}
