{
    "name": "mystique",
    "main": "n/a",
    "version": "1.8.20",
    "repository": "https://github.com/headout/mystique.git",
    "description": "Microbrands @ Headout",
    "author": "Aakash Goel",
    "license": "UNLICENSED",
    "scripts": {
        "build": "next build",
        "production": "node ./deployment/production && find now.*.json | xargs -n1 -I {} /bin/bash -c 'now -A {} --scope headout --prod --no-clipboard --debug' && rm -r now.*.json",
        "staging": "node ./deployment/stage && find now.*.json | xargs -n1 -I {} /bin/bash -c 'now -A {} --scope headout --prod --no-clipboard --debug' && rm -r now.*.json"
    },
    "dependencies": {
        "@sendgrid/mail": "^6.4.0",
        "@sentry/node": "^5.11.1",
        "axios": "^0.19.0",
        "classnames": "^2.2.6",
