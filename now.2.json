{
  "version": 2,
  "alias": [
    "stage.rembrandthuis-museum.tickets-amsterdam.com",
    "stage.siena-cathedral.florencetickets.org",
    "stage.www.day-trips-from-florence.com",
    "stage.catacombs.tickets-rome.com",
    "stage.colosseum.tickets-rome.com",
    "stage.www.tickets-london.co.uk",
    "stage.reggiadicaserta.tickets-naples.com",
    "stage.microbrands.headout.com"
  ],
  "name": "mystique stage",
  "routes": [
    {
      "src": "/_next/(.*)",
      "dest": "/_next/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/static/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "/api/robots"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/terms",
      "dest": "/terms"
    },
    {
      "src": "/create-uid",
      "dest": "/create-uid.html"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/prismic/preview(.*)",
      "dest": "/api/preview"
    },
    {
      "src": "/prismic/resolve(.*)",
      "dest": "/api/resolve"
    },
    {
      "src": "/(.*)",
      "dest": "/index"
    }
  ]
}
