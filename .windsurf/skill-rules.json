{
  "version": "1.0",
  "description": "Skill activation triggers for HeadoutAgentsConfig. Controls when skills automatically suggest.",
  "skills": {
    "create_handoff": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "critical",
      "description": "Create handoff document to preserve work across sessions",
      "promptTriggers": {
        "keywords": [
          "handoff",
          "create handoff",
          "preserve work",
          "save progress",
          "context high",
          "before clear"
        ],
        "intentPatterns": [
          "(create|make|write).*?handoff",
          "(preserve|save).*?(work|progress|context)",
          "before.*(clear|compaction)"
        ]
      }
    },
    "resume_handoff": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "critical",
      "description": "Resume work from handoff document",
      "promptTriggers": {
        "keywords": [
          "resume handoff",
          "resume work",
          "continue from",
          "pick up where",
          "latest handoff"
        ],
        "intentPatterns": [
          "(resume|continue|pick up).*?(handoff|work|where)",
          "latest.*?handoff"
        ]
      }
    },
    "create_plan": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Create implementation plan with research and validation",
      "promptTriggers": {
        "keywords": [
          "create plan",
          "make plan",
          "implementation plan",
          "plan this",
          "how should we implement"
        ],
        "intentPatterns": [
          "(create|make|write).*?plan",
          "plan.*(this|feature|implementation)",
          "how.*?(should|would).*?implement"
        ]
      }
    },
    "multi_repo_plan": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Create implementation plans across multiple repositories with contract passing",
      "promptTriggers": {
        "keywords": [
          "multi repo",
          "multiple repos",
          "multiple repositories",
          "frontend and backend",
          "backend and frontend",
          "cross repo",
          "across repos",
          "plan across",
          "multi codebase",
          "multiple codebases",
          "continue multi repo",
          "multi repo continue",
          "multi repo plan continue",
          "resume multi repo",
          "next repo plan",
          "continue planning repos"
        ],
        "intentPatterns": [
          "(multi|multiple|cross).*?(repo|codebase)",
          "(frontend|backend).*?and.*?(frontend|backend)",
          "plan.*?(across|multiple).*?(repo|codebase)",
          "(prd|spec|feature).*?(multiple|several).*?(repo|codebase)",
          "(continue|resume|next|pick up).*?multi.*?(repo|codebase)",
          "multi.*?(repo|codebase).*?(continue|resume|next)",
          "(continue|resume).*?planning.*?repo"
        ]
      }
    },
    "implement_plan": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Implement plan from thoughts/shared/plans with verification",
      "promptTriggers": {
        "keywords": [
          "implement plan",
          "execute plan",
          "implement the plan",
          "follow the plan"
        ],
        "intentPatterns": [
          "(implement|execute|follow).*?plan",
          "build.*?from.*?plan"
        ]
      }
    },
    "feature-interview": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Interview user to create comprehensive feature specification",
      "promptTriggers": {
        "keywords": [
          "build me",
          "create app",
          "new project",
          "new feature",
          "add feature",
          "feature spec",
          "feature interview"
        ],
        "intentPatterns": [
          "(build|create|make).*?(me|app|project|feature)",
          "(new|add).*?feature",
          "feature.*(spec|interview)"
        ]
      }
    },
    "commit": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Create git commits without Claude attribution",
      "promptTriggers": {
        "keywords": [
          "commit",
          "git commit",
          "push changes",
          "save changes"
        ],
        "intentPatterns": [
          "(commit|push).*?(changes|code)",
          "git.*?commit"
        ]
      }
    },
    "debug": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Debug issues by investigating logs, database, git history",
      "promptTriggers": {
        "keywords": [
          "debug",
          "not working",
          "broken",
          "error",
          "investigate",
          "what's wrong"
        ],
        "intentPatterns": [
          "(debug|investigate|diagnose).*?(issue|error|problem)",
          "(not|isn't).*?working",
          "what.*?(wrong|broken|failing)"
        ]
      }
    },
    "research-agent": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Research external documentation, best practices, library APIs",
      "promptTriggers": {
        "keywords": [
          "research",
          "best practices",
          "how does",
          "documentation",
          "library docs"
        ],
        "intentPatterns": [
          "(research|find|look up).*?(best practices|docs|documentation)",
          "how.*?(does|should).*?(library|api|framework)"
        ]
      }
    },
    "add-agent-config": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
