{
  "version": 2,
  "alias": ["microbrand.vaticantickets.org"],
  "name": "mystique stage",
  "routes": [
    {
      "src": "/_next/(.*)",
      "dest": "/_next/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/terms",
      "dest": "/terms"
    },
    {
      "src": "/(.*)",
      "dest": "/index"
    }
  ]
}
