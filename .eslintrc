{
  "extends": [
    "eslint:recommended",
    "plugin:prettier/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:jsx-a11y/recommended"
  ],
  "plugins": [
    "@typescript-eslint",
    "prettier",
    "react",
    "react-hooks",
    "jsx-a11y",
    "import",
    "simple-import-sort"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "varsIgnorePattern": "^_" }
    ],
    "react/no-unknown-property": [
      2,
      {
        "ignore": ["jsx", "global", "text", "font-color", "stop-Color"]
      }
    ],
    "react/jsx-no-target-blank": "off",
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "no-unused-vars": "off",
    "no-case-declarations": "off",
    "no-console": "error",
    "prettier/prettier": "off",
    "simple-import-sort/imports": [
      "error",
      {
        "groups": [
          [
            //react/next/prismic related packages
            "^react",
            "^next",
            "^prismic",
            "^config",
            "^styled",
            "^recoil",
            "^(?!@headout)",
            "^(?!// @ts-expect-error)",
            "^@?\\w",
            // internal packages
            "^@headout",
            //components
            "^components",
            "^(?!components/hooks)",
            "^UI",
            //contexts/hooks/utils
            "^contexts",
            "^hooks",
            "^utils",
            //atoms
            "^atoms",
            "^store",
            //assets/statics/labels/constants
            "^const",
            "^constants",
            "^assets",
            "^static",
            //side effect imports.
            "^\\u0000",
            //parent imports. put `..` last
            "^\\.\\.(?!/?$)",
            "^\\.\\./?$",
            //other relative imports. put same-folder imports and `.` last
            "^\\./(?=.*/)(?!/?$)",
            "^\\.(?!/?$)",
            "^\\./?$"
          ]
        ]
      }
    ],
    "simple-import-sort/exports": "error",
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-duplicates": "error"
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "overrides": [
    {
      "files": ["*.d.ts"],
      "rules": {
        "no-undef": "off"
      }
    }
  ],
  "env": {
    "es6": true,
    "browser": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "detect"
    },
    "import/ignore": ["node_modules/react-native/index\\.js$"],
		"import/parsers": {
			"@typescript-eslint/parser": [".ts", ".tsx"]
		},
		"import/resolver": {
			"typescript": {
				"alwaysTryTypes": true // try to resolve types under `<root>@types` directory even if it doesn't contain any source code, like `@types/unist`
			}
		}
  }
}