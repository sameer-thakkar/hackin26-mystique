    },
    "devDependencies": {
        "@commitlint/cli": "^8.3.5",
        "@commitlint/config-conventional": "^8.3.4",
        "@types/node": "^12.7.1",
        "@types/react": "^16.9.0",
        "css-loader": "^3.4.2",
        "extract-css-chunks-webpack-plugin": "^4.7.4",
        "find-up": "^4.1.0",
        "husky": "^4.2.1",
        "ignore-loader": "~0.1.2",
        "optimize-css-assets-webpack-plugin": "^5.0.1",
        "postcss-loader": "^3.0.0",
        "prettier": "^1.18.2",
