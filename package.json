        "isomorphic-unfetch": "^3.0.0",
        "lazysizes": "^5.1.1",
        "libphonenumber-js": "^1.7.22",
        "moment": "^2.24.0",
        "next": "^9.0.4",
        "prismic-javascript": "^2.1.1",
        "prismic-reactjs": "^1.0.1",
        "react": "^16.9.0",
        "react-alice-carousel": "^1.15.2",
        "react-copy-to-clipboard": "^5.0.1",
        "react-datepicker": "^2.8.0",
        "react-dom": "^16.9.0",
        "react-html-parser": "^2.0.2",
        "react-id-swiper": "^2.3.2",
        "react-json-tree": "^0.11.2",
        "react-markdown": "^4.2.1",
        "react-modal": "^3.9.1",
        "react-scroll": "^1.7.14",
        "react-select": "^3.0.4",
