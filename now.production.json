{
  "version": 2,
  "alias": [
    "www.mezquita-de-cordoba.org",
    "siam-parks.tickets-tenerife.com",
    "loro-parque.tickets-tenerife.com",
    "picasso-museum.tickets-barcelona.org",
    "hop-on-hop-off.tickets-barcelona.org",
    "la-giralda.sevilletickets.com",
    "city-card.tickets-amsterdam.com",
    "boboli-gardens.florencetickets.org",
    "palazzo-pitti.florencetickets.org",
    "www.daytripfromparis.com",
    "toledo.tickets-madrid.org",
    "microbrands.headout.com"
  ],
  "name": "mystique prod",
  "routes": [
    {
      "src": "/_next/(.*)",
      "dest": "/_next/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/static/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "/static/robots.txt"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/terms",
      "dest": "/terms"
    },
    {
      "src": "/create-uid",
      "dest": "/create-uid.html"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/(.*)",
      "dest": "/index"
    }
  ]
}
