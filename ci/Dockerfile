FROM node:20-alpine AS runner
ARG APP_ENV
ARG SLACK_GRP_BKNG_WEBHOOK
ARG ZENDESK_GRP_BKNG_TOKEN
ARG NEXT_PUBLIC_ODE_NAMESPACE
ARG WAF_API_WHITELIST_TOKEN
ENV NODE_ENV=$APP_ENV \
    SLACK_GRP_BKNG_WEBHOOK=${SLACK_GRP_BKNG_WEBHOOK} \
    ZENDESK_GRP_BKNG_TOKEN=${ZENDESK_GRP_BKNG_TOKEN} \
    NEXT_PUBLIC_HEADOUT_DOMAIN=${NEXT_PUBLIC_HEADOUT_DOMAIN} \
    NEXT_PUBLIC_HEADOUT_API_DOMAIN=${NEXT_PUBLIC_HEADOUT_API_DOMAIN} \
    APP_ENV=$APP_ENV \
    NEXT_PUBLIC_ODE_NAMESPACE=$NEXT_PUBLIC_ODE_NAMESPACE \
    WAF_API_WHITELIST_TOKEN=${WAF_API_WHITELIST_TOKEN}
ADD ./ /mystique/
EXPOSE 3000
WORKDIR /mystique
ENTRYPOINT ["npm"]
CMD ["run", "-s", "start"]
