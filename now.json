{
  "version": 2,
  "alias": [
    "stage.www.vaticantickets.org",
    "stage.www.mezquita-de-cordoba.org",
    "stage.siam-parks.tickets-tenerife.com",
    "stage.loro-parque.tickets-tenerife.com",
    "stage.picasso-museum.tickets-barcelona.org",
    "stage.hop-on-hop-off.tickets-barcelona.org",
    "stage.la-giralda.sevilletickets.com",
    "stage.city-card.tickets-amsterdam.com",
    "stage.boboli-gardens.florencetickets.org",
    "stage.palazzo-pitti.florencetickets.org",
    "stage.www.daytripfromparis.com",
    "stage.toledo.tickets-madrid.org",
    "stage.microbrands.headout.com"
  ],
  "name": "mystique stage",
  "routes": [
    {
      "src": "/_next/(.*)",
      "dest": "/_next/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/static/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "/static/robots.txt"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/terms",
      "dest": "/terms"
    },
    {
      "src": "/create-uid",
      "dest": "/create-uid.html"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/(.*)",
      "dest": "/index"
    }
  ]
}
