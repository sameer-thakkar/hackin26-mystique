{
  "name": "mystique",
  "main": "n/a",
  "version": "2.2.6",
  "repository": "https://github.com/headout/mystique.git",
  "description": "Microbrands @ Headout",
  "author": "Aakash Goel",
  "license": "UNLICENSED",
  "scripts": {
    "build": "next build",
    "production": "node ./deployment/production && find now.*.json | xargs -n1 -I {} /bin/bash -c 'now -A {} --scope headout --prod --no-clipboard --debug' && rm -r now.*.json",
    "staging": "node ./deployment/stage && find now.*.json | xargs -n1 -I {} /bin/bash -c 'now -A {} --scope headout --prod --no-clipboard --debug' && rm -r now.*.json",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "deploy-storybook": "storybook-to-ghpages"
  },
  "dependencies": {
    "@sendgrid/mail": "^6.4.0",
    "@sentry/node": "^5.11.1",
    "axios": "^0.19.0",
    "classnames": "^2.2.6",
    "cookies": "^0.8.0",
    "fuse.js": "^3.4.6",
    "isomorphic-unfetch": "^3.0.0",
    "lazysizes": "^5.1.1",
    "libphonenumber-js": "^1.7.22",
    "moment": "^2.24.0",
    "next": "^9.0.4",
    "prismic-javascript": "^2.1.1",
    "prismic-reactjs": "^1.0.1",
    "react": "^16.9.0",
    "react-copy-to-clipboard": "^5.0.1",
    "react-datepicker": "^2.8.0",
    "react-dom": "^16.9.0",
    "react-html-parser": "^2.0.2",
    "react-id-swiper": "^2.3.2",
    "react-markdown": "^4.2.1",
    "react-modal": "^3.9.1",
    "react-scroll": "^1.7.14",
    "react-select": "^3.0.4",
    "react-telephone-input": "^4.73.4",
    "react-zoom-pan-pinch": "^1.6.1",
    "signale": "^1.4.0",
    "slack-webhook": "^1.0.0",
    "styled-components": "^5.0.1",
    "swiper": "^5.3.0",
    "url-parse": "^1.4.7",
    "xmlbuilder": "^13.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.8.4",
    "@commitlint/cli": "^8.3.5",
    "@commitlint/config-conventional": "^8.3.4",
    "@storybook/addon-actions": "^5.3.12",
    "@storybook/addon-knobs": "^5.3.13",
    "@storybook/addon-links": "^5.3.12",
    "@storybook/addon-viewport": "^5.3.13",
    "@storybook/addons": "^5.3.12",
    "@storybook/react": "^5.3.12",
    "@storybook/storybook-deployer": "^2.8.1",
    "@types/node": "^12.7.1",
    "@types/react": "^16.9.0",
    "babel-loader": "^8.0.6",
    "babel-plugin-styled-components": "^1.10.7",
    "babel-preset-react-app": "^9.1.1",
    "css-loader": "^3.4.2",
    "extract-css-chunks-webpack-plugin": "^4.7.4",
    "find-up": "^4.1.0",
    "husky": "^4.2.1",
    "ignore-loader": "~0.1.2",
    "optimize-css-assets-webpack-plugin": "^5.0.1",
    "prettier": "^1.18.2",
    "pretty-quick": "^2.0.1",
    "react-is": "^16.12.0",
    "style-loader": "^1.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^3.5.3"
  },
  "husky": {
