{
  "version": 2,
  "alias": ["microbrand.tickets-amsterdam.com", "microbrand.eiffeltickets.com"],
  "name": " mystique",
  "routes": [
    {
      "src": "/_next/(.*)",
      "dest": "/_next/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index"
    }
  ]
}
